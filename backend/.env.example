# Copy to .env and fill in. Defaults work for local dev with fixtures.
# Every setting in app/config.py is listed here with the same default the code uses (tests/test_docs_accuracy.py checks this).
# Exception: DEV_FIXTURES is 1 here (local dev) but 0 in the code. Production must have DEV_FIXTURES=0.

# ---- Database ----
DATABASE_URL=postgresql+psycopg://clientfinder:dev_only_change_me@localhost:5433/clientfinder

# Optional but recommended in production: DATABASE_URL = limited role (deploy/db_least_privilege.sql),
# MIGRATION_DATABASE_URL = owner login used only by alembic.
MIGRATION_DATABASE_URL=

# ---- Dev mode flags ----
# DEV_FIXTURES=1: scrapers use local JSON/HTML fixtures instead of hitting real APIs, so you can iterate without
# SerpAPI or Anthropic keys. FAKE DATA: use 1 only on a throwaway local DB. NEVER set to 1 on the production server;
# fixture rows would appear on clientfinder.ai.
DEV_FIXTURES=1
# Interactive API docs at /docs and /openapi.json. 0 (default) hides them. Set 1 for local development only.
ENABLE_DOCS=0

# ---- Google-search layer (SerpAPI or Serper) ----
# Only used when DEV_FIXTURES=0
SERPAPI_API_KEY=
SERPER_API_KEY=
GOOGLE_SEARCH_PROVIDER=serpapi
# Hard monthly stop for the Google layer. SerpAPI's free tier is ~100 searches/month, the ~$75 plan ~5,000.
# Set this to your plan's limit minus a margin. The default plan is 150 queries; at 6 per hourly run that is at most ~4,320 searches/month. One customer search is 20 Google searches.
SERPAPI_MONTHLY_BUDGET=4500
# What one Google search costs YOU (plan price / searches). Customers pay this x 1.5 for each Google search a live search runs (20 by default).
SERPAPI_COST_PER_SEARCH_USD=0.015
# Live searches by customers: repeat of the same search within this many hours is free (served from the database).
SEARCH_CACHE_HOURS=6
USER_SEARCHES_PER_DAY=20
# Google results processed per live search, and live searches running at once across the whole site.
USER_SEARCH_RESULTS=10
USER_SEARCH_MAX_CONCURRENT=3
# Turning on the scheduled Google plan spends YOUR money on a timer. Leave 0: customers pay for their own searches.
GOOGLE_SCHEDULE_ENABLED=0
GOOGLE_SEARCH_INTERVAL_MINUTES=60
GOOGLE_QUERY_CYCLE_HOURS=12
GOOGLE_MAX_QUERIES_PER_TICK=6
# How often the free feeds (RemoteOK, Remotive, WWR, Greenhouse, Lever, Ashby, ProBlogger) are pulled.
DURABLE_SOURCES_INTERVAL_HOURS=6

# ---- Firecrawl (optional, fallback when Playwright blocked) ----
FIRECRAWL_API_KEY=
# Chromium for JS-heavy pages. Keep 0 until the scraper runs as a non-root user (docs/SECURITY.md).
PLAYWRIGHT_FALLBACK=0

# ---- Claude ----
# Only used when DEV_FIXTURES=0
ANTHROPIC_API_KEY=
# Cheap, fast extraction model. Must be listed in app/pricing.py (customer prices are computed from it).
EXTRACTION_MODEL=claude-haiku-5-5
# Pitch helper (first messages, cover letters, reply help). Billed at 1.5x its cost.
ASSIST_MODEL=claude-haiku-5-5
ASSIST_PER_DAY=60

# ---- Accounts and access ----
# Free credit for a new account. 0 = off. Set about 0.75 to give every new customer one free live search (a search is quoted near $0.66).
# There is no email verification yet, so it is limited: one per real mailbox (name+tag@ and gmail dots count as one) and at most
# SIGNUP_BONUS_DAILY_CAP in any 24 hours across the whole site (0 = no cap). Worst case per day is cap x the search cost to you.
SIGNUP_BONUS_USD=0
SIGNUP_BONUS_DAILY_CAP=25
# The job feed needs a signed-in account. Set 0 only for local development.
JOBS_REQUIRE_LOGIN=1
# Per-IP requests per minute on the public job endpoints (0 = off).
PUBLIC_RATE_LIMIT_PER_MIN=120
# Sanity cap on a single admin credit grant/revoke, in USD.
MAX_CREDIT_ADJUST_USD=1000
# Public address of the site (used in checkout return links).
PUBLIC_URL=https://clientfinder.ai
# Only these emails can create an admin account (created on the server with scripts/admin_cli.py create-admin, which asks for a password).
ADMIN_EMAILS=christian@emailsandsms.com
# Admin 2FA. 1 (default) = authenticator code required. 0 = email + password only (weaker).
ADMIN_REQUIRE_2FA=1
BACKUP_DIR=/var/backups/clientfinder

# ---- Sessions / encryption ----
# 1 = serve the session cookie over HTTPS only (production). Set 0 only for local http development.
COOKIE_SECURE=1
# Hours a sign-in lasts.
SESSION_HOURS=12
# REQUIRED in production: >= 32 random chars. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-dev-only
# Encrypts 2FA secrets. Separate so rotating JWT_SECRET never breaks 2FA. Generate the same way, a different value.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_PREVIOUS=

# ---- Email (Phase 4+; nothing is sent yet) ----
RESEND_API_KEY=
EMAIL_FROM=noreply@clientfinder.ai

# ---- Payments (Whop) ----
# Best: the server makes a checkout link for each click through Whop's API. Test with: .venv/bin/python scripts/whop_check.py
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_PRODUCT_ID=
# Signing secret from Whop > Developer > Webhooks (endpoint https://clientfinder.ai/webhooks/whop). Empty = webhook refuses everything.
WHOP_WEBHOOK_SECRET=
# "dollars" or "cents": how Whop's payment amount field is expressed (unverified against a real payment).
WHOP_AMOUNT_UNIT=dollars
# A single payment above this many USD is held for review instead of auto-credited.
WHOP_MAX_TOPUP_USD=500
# Your Whop checkout page for buying credits (https only). Shown as a "Buy credits" button.
WHOP_CHECKOUT_URL=
# Fallback only if you are not using the API: one Whop checkout link per credit bundle. Create a plan at exactly that price in Whop, copy its checkout link here.
WHOP_CHECKOUT_27=
WHOP_CHECKOUT_47=
WHOP_CHECKOUT_97=

# If the database is behind the code (a migration was not applied after a git pull) the API refuses to start instead of 500-ing on a customer.
# 1 = refuse to start (default, recommended). 0 = start anyway and report it on /health and the admin dashboard.
SCHEMA_CHECK_STRICT=1
# A payment with no account id on it (matched only by the buyer's email) is auto-credited only if it equals a credit pack ($27/$47/$97).
WHOP_EMAIL_MATCH_BUNDLES_ONLY=1
