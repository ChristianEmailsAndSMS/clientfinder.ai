# Copy to .env and fill in. Defaults work for local dev with fixtures.

# ---- Database ----
DATABASE_URL=postgresql+psycopg://clientfinder:dev_only_change_me@localhost:5433/clientfinder

# Optional but recommended in production: DATABASE_URL = limited role (deploy/db_least_privilege.sql),
# MIGRATION_DATABASE_URL = owner login used only by alembic.
MIGRATION_DATABASE_URL=

# ---- Dev mode flags ----
# When # !! FAKE DATA. Use 1 only on a throwaway local DB. NEVER set to 1 on the production server;
# fixture rows would appear on clientfinder.ai. Production must have DEV_FIXTURES=0.
DEV_FIXTURES=1, scrapers use local JSON/HTML fixtures instead of hitting real APIs.
# Lets you iterate without SerpAPI or Anthropic keys.
DEV_FIXTURES=1

# ---- Google-search layer (SerpAPI or Serper) ----
# Only used when DEV_FIXTURES=0
SERPAPI_API_KEY=
SERPER_API_KEY=
GOOGLE_SEARCH_PROVIDER=serpapi
# Hard monthly stop for the Google layer. SerpAPI's free tier is ~100 searches/month, the ~$75 plan ~5,000.
# Set this to your plan's limit minus a margin. The default plan is 34 queries re-run every 12h (~2,040 searches/month).
SERPAPI_MONTHLY_BUDGET=4500
# What one Google search costs YOU (plan price / searches). Customers pay this x 1.5 for a live search.
SERPAPI_COST_PER_SEARCH_USD=0.015
# Live searches by customers: repeat of the same search within this many hours is free (served from the database).
SEARCH_CACHE_HOURS=6
USER_SEARCHES_PER_DAY=20
# Free credit for a new account. Leave 0 until email verification exists (otherwise throwaway accounts farm it).
SIGNUP_BONUS_USD=0
GOOGLE_QUERY_CYCLE_HOURS=12
GOOGLE_MAX_QUERIES_PER_TICK=6

# ---- Firecrawl (optional, fallback when Playwright blocked) ----
FIRECRAWL_API_KEY=

# ---- Claude ----
# Only used when DEV_FIXTURES=0
ANTHROPIC_API_KEY=
# Haiku 4.5 for cheap extraction; Sonnet 5 for higher accuracy. Benchmark both.
EXTRACTION_MODEL=claude-haiku-4-5-20251001

# ---- Admin accounts ----
# Only these emails can create an admin account, and only with a one-time code printed on the server.
ADMIN_EMAILS=christian@emailsandsms.com
BACKUP_DIR=/var/backups/clientfinder
# 1 = serve the session cookie over HTTPS only (production). Set 0 only for local http development.
COOKIE_SECURE=1

# ---- Sessions / encryption ----
# REQUIRED in production: >= 32 random chars. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-dev-only
# Encrypts 2FA secrets. Separate so rotating JWT_SECRET never breaks 2FA. Generate the same way, a different value.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_PREVIOUS=
JWT_ALG=HS256

# ---- Email (Phase 4+) ----
RESEND_API_KEY=
EMAIL_FROM=noreply@clientfinder.ai

# ---- Payments (Phase 5+) ----
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
